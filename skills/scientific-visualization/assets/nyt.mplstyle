# NYT (New York Times editorial) style — slide-optimized
# Usage: plt.style.use('/dbfs/FileStore/ds-skills/scientific-visualization/assets/nyt.mplstyle')
#
# Default context: slides (16:9, base_size=15).
# For notebooks, override: plt.rcParams.update({'font.size': 11, 'figure.figsize': [7, 4]})

# Figure — single full-width chart in slide content area
# Slide layout: header ~0.8", figure ~4.2", body text ~0.9", footnote ~0.3"
# Usable width ~12.0" (13.3" slide minus 0.65" margins each side)
figure.facecolor: white
figure.edgecolor: white
figure.figsize: 12.0, 4.2
figure.dpi: 100
figure.constrained_layout.use: True

# Font — Franklin Gothic / Arial Narrow (NYT preferred)
font.family: sans-serif
font.sans-serif: Franklin Gothic Medium, Arial Narrow, Helvetica Neue, Arial, DejaVu Sans
font.size: 15

# Axes
axes.facecolor: white
axes.edgecolor: #DEDEDE
axes.linewidth: 1.0
axes.labelsize: 14
axes.labelcolor: #555555
axes.labelpad: 8
axes.titlesize: 17
axes.titleweight: bold
axes.titlecolor: #111111
axes.titlelocation: left
axes.titlepad: 12

# Spines — no left spine (gridlines serve as y-axis reference)
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.spines.bottom: True

axes.axisbelow: True

# Grid — horizontal only, very light
axes.grid: True
axes.grid.axis: y
grid.color: #DEDEDE
grid.linewidth: 0.8
grid.linestyle: -
grid.alpha: 1.0

# Ticks — no visible tick marks
xtick.major.size: 0
xtick.minor.size: 0
ytick.major.size: 0
ytick.minor.size: 0
xtick.major.pad: 8
ytick.major.pad: 6
xtick.labelsize: 13
ytick.labelsize: 13
xtick.color: #555555
ytick.color: #555555

# Lines — heavier for slide legibility
lines.linewidth: 2.5
lines.solid_capstyle: round
lines.dash_capstyle: round
lines.markersize: 7

# Patches
patch.edgecolor: white
patch.linewidth: 0.5

# Legend
legend.frameon: False
legend.fontsize: 13
legend.labelcolor: #333333
legend.borderaxespad: 0

# Color cycle (NYT palette — blue primary)
axes.prop_cycle: cycler('color', ['326891', 'C9553E', '3A7D44', '7B5EA7', '2A8C8A', 'C4A35A'])

# Savefig
savefig.dpi: 150
savefig.facecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.15
